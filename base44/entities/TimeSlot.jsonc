{
  "name": "TimeSlot",
  "type": "object",
  "properties": {
    "court_id": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "booked",
        "blocked"
      ],
      "default": "available"
    },
    "price": {
      "type": "number"
    },
    "is_recurring": {
      "type": "boolean",
      "default": false
    },
    "recurring_day": {
      "type": "number"
    }
  },
  "required": [
    "court_id",
    "venue_id",
    "date",
    "start_time",
    "end_time",
    "price"
  ]
}