{
  "name": "RecurringSchedule",
  "type": "object",
  "properties": {
    "court_id": {
      "type": "string"
    },
    "venue_id": {
      "type": "string"
    },
    "day_of_week": {
      "type": "number",
      "description": "0=Sunday, 1=Monday, ..., 6=Saturday"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "court_id",
    "venue_id",
    "day_of_week",
    "start_time",
    "end_time",
    "price"
  ]
}